{
  "name": "labtrack-server",
  "version": "1.0.0",
  "private": true,
  "description": "LabTrack API: Node.js + Express + TypeScript, REST and GraphQL",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node -r ./dist/tracing.js dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest --coverage"
  },
  "dependencies": {
    "@opentelemetry/instrumentation-express": "0.71.1",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-pg": "0.76.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "express": "4.22.3",
    "express-rate-limit": "7.4.1",
    "graphql": "16.9.0",
    "graphql-http": "1.22.1",
    "helmet": "8.0.0",
    "pg": "8.13.0",
    "prom-client": "15.1.3",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/jest": "29.5.13",
    "@types/node": "20.16.11",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.6.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/index.ts",
      "!src/tracing.ts",
      "!src/repository/PostgresSampleRepository.ts"
    ]
  }
}
